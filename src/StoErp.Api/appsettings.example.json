{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ConnectionString":"Host=your_host; Port=your_port;Database=your_database;Username=your_username;Password=your_password"
  },
  "JwtOptions": {
    "Issuer": "your_issuer",
    "Audience": "your_audience",
    "Secret": "your_secret_key"
  },
  "TokenLifeTimeOptions": {
    "AccessTokenLifeTimeInMinutes": "your_access_token_lifetime_in_minutes",
    "RefreshTokenLifeTimeInDays": "your_refresh_token_lifetime_in_days"
  },
  "VerificationTokenOptions": {
    "VerificationTokenLifeTimeInMinutes": "your_verification_token_lifetime_in_minutes",
    "VerificationTokenLength": "your_verification_token_length",
    "VerificationTokenOnlyNumbers": "your_verification_token_only_numbers"
  },
  "SmtpOptions": {
    "Host": "your_smtp_host",
    "Port": "your_smtp_port",
    "Secure": "true_or_false",
    "User": "your_email_user",
    "Pass": "your_email_password"
  }
}
